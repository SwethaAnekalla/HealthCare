# Database
DATABASE_URL=postgresql://caresync:caresync_dev_password@localhost:5432/caresync

# Redis (optional; in-memory fallback available)
REDIS_URL=redis://localhost:6379

# API Server
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_REFRESH_EXPIRY=7d

# Payment Provider (mock | razorpay)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Provider (log | nodemailer)
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Symptom Matcher (deterministic | anthropic | openai)
SYMPTOM_MATCHER_PROVIDER=deterministic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=http://localhost:5173

# Demo/Seed
SEED_DEMO_DATA=true
