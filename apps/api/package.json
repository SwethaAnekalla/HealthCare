    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.2",
    "socket.io": "^4.7.2",
    "zod": "^3.22.4",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.8.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.4",
    "typescript": "^5.2.2",
    "tsx": "^4.1.0",
    "prisma": "^5.4.1",
    "vitest": "^0.34.6",
